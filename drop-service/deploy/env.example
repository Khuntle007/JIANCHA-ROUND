# /opt/jc-round-drop/.env  (chmod 600, owner root — never commit)
PORT=8093
DATA_DIR=/opt/jc-round-drop/data
JCR_API=http://127.0.0.1:8092
PUBLIC_ORIGIN=https://jc-round.scm-backoffice.com
MAIL_FROM=Noreply@jianchatea.com
# Same Entra app as Recipe-DB ("JIANCHA Recipe DB Mailer", Mail.Send application permission)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# 1 = write emails to data/outbox instead of sending (auto when GRAPH_CLIENT_SECRET is empty)
MAIL_DRY_RUN=0
MAX_PDF_BYTES=15728640

# --- Dynamics 365 Business Central (item No. + Description sync). Optional: leave empty to disable.
# Needs an Entra app registered in BC (Microsoft Entra Applications page, permission set to read Items) with API permission "Dynamics 365 Business Central > API.ReadWrite.All (Application)".
# BC_TENANT_ID / BC_CLIENT_ID / BC_CLIENT_SECRET default to the GRAPH_* values above if not set.
BC_TENANT_ID=
BC_CLIENT_ID=
BC_CLIENT_SECRET=
BC_ENVIRONMENT=Production
BC_COMPANY=Jian Cha Co.,Ltd.
