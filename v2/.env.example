# jc-round v2 — copy to .env (never commit)
DATABASE_URL="file:../data/jcround.db"
DATA_DIR="./data"                 # PDF files for Order Drop
APP_URL="http://localhost:3100"   # public origin used in emails / links (prod: https://jc-round.scm-backoffice.com)
SESSION_SECRET=""                 # >= 32 random chars (openssl rand -hex 32) — app refuses to start without it
MAIL_SENDER="Noreply@jianchatea.com"
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""            # empty → emails are written to DATA_DIR/outbox (dry run)
MAX_PDF_BYTES=15728640
